diff --git a/Builder/jni/mupdf-image.c b/Builder/jni/mupdf-image.c
new file mode 100644
index 0000000..f45b6da
--- /dev/null
+++ b/Builder/jni/mupdf-image.c
@@ -0,0 +1,92 @@
+#include <jni.h>
+#include <limits.h>
+#include <math.h>
+#include <stdio.h>
+#include "mupdf/fitz.h"
+
+/* Covers and image previews need an Android-decodable stream as well as pages. */
+JNIEXPORT jbyteArray JNICALL
+Java_org_ebookdroid_droids_mupdf_codec_MuPdfImage_nativeDecodeToPng(
+    JNIEnv *env, jclass clazz, jbyteArray encoded, jint requested_width)
+{
+    fz_context *ctx;
+    fz_buffer *input = NULL, *png = NULL;
+    fz_stream *stream = NULL;
+    fz_document *doc = NULL;
+    fz_page *page = NULL;
+    fz_pixmap *pixmap = NULL;
+    jbyte *bytes;
+    jbyteArray result = NULL;
+    char error[256] = {0};
+    int failed = 0;
+    jsize length;
+
+    if (!encoded || requested_width <= 0)
+        return NULL;
+    length = (*env)->GetArrayLength(env, encoded);
+    bytes = (*env)->GetByteArrayElements(env, encoded, NULL);
+    if (!bytes)
+        return NULL;
+    ctx = fz_new_context(NULL, NULL, FZ_STORE_DEFAULT);
+    if (!ctx)
+    {
+        (*env)->ReleaseByteArrayElements(env, encoded, bytes, JNI_ABORT);
+        (*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/OutOfMemoryError"), "MuPDF image context");
+        return NULL;
+    }
+
+    fz_var(input);
+    fz_var(png);
+    fz_var(stream);
+    fz_var(doc);
+    fz_var(page);
+    fz_var(pixmap);
+    fz_var(result);
+    fz_var(failed);
+    fz_try(ctx)
+    {
+        fz_rect bounds;
+        float width, scale;
+        unsigned char *data;
+        size_t size;
+
+        fz_register_document_handlers(ctx);
+        input = fz_new_buffer_from_shared_data(ctx, (unsigned char *)bytes, length);
+        stream = fz_open_buffer(ctx, input);
+        doc = fz_open_document_with_stream(ctx, "image", stream);
+        page = fz_load_page(ctx, doc, 0);
+        bounds = fz_bound_page(ctx, page);
+        width = bounds.x1 - bounds.x0;
+        if (!isfinite(width) || width <= 0)
+            fz_throw(ctx, FZ_ERROR_FORMAT, "invalid image dimensions");
+        scale = fz_min(1, requested_width / width);
+        pixmap = fz_new_pixmap_from_page(ctx, page, fz_scale(scale, scale), fz_device_rgb(ctx), 1);
+        png = fz_new_buffer_from_pixmap_as_png(ctx, pixmap, fz_default_color_params);
+        size = fz_buffer_storage(ctx, png, &data);
+        if (size > INT_MAX)
+            fz_throw(ctx, FZ_ERROR_LIMIT, "decoded image is too large");
+        result = (*env)->NewByteArray(env, (jsize)size);
+        if (result)
+            (*env)->SetByteArrayRegion(env, result, 0, (jsize)size, (jbyte *)data);
+    }
+    fz_always(ctx)
+    {
+        fz_drop_buffer(ctx, png);
+        fz_drop_pixmap(ctx, pixmap);
+        fz_drop_page(ctx, page);
+        fz_drop_document(ctx, doc);
+        fz_drop_stream(ctx, stream);
+        fz_drop_buffer(ctx, input);
+    }
+    fz_catch(ctx)
+    {
+        failed = 1;
+        snprintf(error, sizeof error, "%s", fz_caught_message(ctx));
+        fz_ignore_error(ctx);
+    }
+    fz_drop_context(ctx);
+    (*env)->ReleaseByteArrayElements(env, encoded, bytes, JNI_ABORT);
+    if (failed && !(*env)->ExceptionCheck(env))
+        (*env)->ThrowNew(env, (*env)->FindClass(env, "java/lang/IllegalArgumentException"), error);
+    return result;
+}
diff --git a/Builder/link_to_mupdf_fork.sh b/Builder/link_to_mupdf_fork.sh
new file mode 100755
index 0000000..3058920
--- /dev/null
+++ b/Builder/link_to_mupdf_fork.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+# Build directly from the sibling vm75/mupdf checkout, preserving its worktree.
+set -euo pipefail
+BUILD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
+ROOT_DIR="$(dirname "$BUILD_DIR")"
+GRADLE_PROPERTIES="${GRADLE_USER_HOME:-$HOME/.gradle}/gradle.properties"
+
+property() {
+    if [[ -f "$GRADLE_PROPERTIES" ]]; then
+ \
+       sed -n "s/^$1=//p" "$GRADLE_PROPERTIES" | tail -n 1
+    fi
+}
+
+MUPDF_ROOT="${LIBRERA_MUPDF_DIR:-$(property librera_mupdf_dir)}"
+MUPDF_ROOT="${MUPDF_ROOT:-$(dirname "$ROOT_DIR")/mupdf}"
+if [[ ! -d "$MUPDF_ROOT/.git" && ! -f "$MUPDF_ROOT/.git" ]]; then
+    git clone --branch main git@github.com:vm75/mupdf.git "$MUPDF_ROOT"
+fi
+MUPDF_ROOT="$(cd "$MUPDF_ROOT" >/dev/null && pwd)"
+if [[ ! -f "$MUPDF_ROOT/scripts/build-android-jxl.py" ]] ||
+   ! grep -q fz_set_reflow_options "$MUPDF_ROOT/include/mupdf/fitz/context.h"; then
+    echo "MuPDF checkout needs the fork's Android codecs and document options: $MUPDF_ROOT" >&2
+    exit 1
+fi
+
+NDK_DIR="${LIBRERA_NDK_DIR:-${ANDROID_NDK_HOME:-$(property librera_ndk_dir)}}"
+if [[ "${1:-}" == fdroid ]]; then
+    NDK_DIR="${LIBRERA_FDROID_NDK_DIR:-$(property librera_fdroid_ndk_dir)}"
+    NDK_DIR="${NDK_DIR:-${LIBRERA_NDK_DIR:-${ANDROID_NDK_HOME:-$(property librera_ndk_dir)}}}"
+fi
+if [[ ! -x "$NDK_DIR/ndk-build" ]]; then
+    echo "Set ANDROID_NDK_HOME, LIBRERA_NDK_DIR, or librera_ndk_dir in $GRADLE_PROPERTIES" >&2
+    exit 1
+fi
+
+read -r -a ABIS <<< "${LIBRERA_ABIS:-armeabi-v7a arm64-v8a x86 x86_64}"
+JOBS="${LIBRERA_NATIVE_JOBS:-4}"
+OUTPUT="$BUILD_DIR/build/mupdf-fork"
+
+# Resolve Artifex's relative URLs against Artifex, then initialize only the
+# decoder dependencies of the libjxl revision pinned by this MuPDF checkout.
+git -C "$MUPDF_ROOT" -c remote.upstream.url=https://github.com/ArtifexSoftware/mupdf.git \
+    -c branch.main.remote=upstream submodule update --init
+git -C "$MUPDF_ROOT/thirdparty/libjxl" submodule update --init \
+    third_party/brotli third_party/highway third_party/skcms
+
+JXL_SDK="${LIBRERA_JXL_SDK_DIR:-$(property librera_jxl_sdk_dir)}"
+JXL_SDK="${JXL_SDK:-$OUTPUT/jxl}"
+# Let CMake check source dependencies every time. Testing only for an existing
+# archive would retain an old SDK after MuPDF updates its bundled codec pins.
+python3 "$MUPDF_ROOT/scripts/build-android-jxl.py" \
+    --ndk "$NDK_DIR" --output "$JXL_SDK" --api 24 --jobs "$JOBS" --abis "${ABIS[@]}"
+
+make -C "$MUPDF_ROOT" generate
+
+"$NDK_DIR/ndk-build" -j"$JOBS" NDK_PROJECT_PATH="$ROOT_DIR" \
+    APP_BUILD_SCRIPT="$BUILD_DIR/jni/Android-fork.mk" \
+    NDK_APPLICATION_MK="$BUILD_DIR/jni/Application.mk" \
+    APP_PLATFORM=android-24 "APP_ABI=${ABIS[*]}" \
+    LIBRERA_MUPDF_ROOT="$MUPDF_ROOT" MUPDF_JXL_ROOT="$JXL_SDK" \
+    NDK_OUT="$OUTPUT/obj" NDK_LIBS_OUT="$OUTPUT/libs"
+
+# Publish outputs only after every requested ABI has built successfully.
+mkdir -p "$ROOT_DIR/app/src/main/jniLibs"
+mkdir -p "$OUTPUT/libs-nomupdf"
+for ABI in "${ABIS[@]}"; do
+    mkdir -p "$ROOT_DIR/app/src/main/jniLibs/$ABI"
+    cp -p "$OUTPUT/libs/$ABI/"*.so "$ROOT_DIR/app/src/main/jniLibs/$ABI/"
+    mkdir -p "$OUTPUT/libs-nomupdf/$ABI"
+    cp -p "$OUTPUT/libs/$ABI/"*.so "$OUTPUT/libs-nomupdf/$ABI/"
+    rm -f "$OUTPUT/libs-nomupdf/$ABI/libmupdf.so"
+done
+# Keep packaged notices aligned with the codec sources used for this build.
+NOTICES="$ROOT_DIR/app/src/main/assets/native-codecs"
+mkdir -p "$NOTICES"
+cp "$JXL_SDK/${ABIS[0]}/licenses/"*.txt "$NOTICES/"
+cp "$MUPDF_ROOT/thirdparty/libwebp/COPYING" "$NOTICES/libwebp.txt"
+python3 - "$MUPDF_ROOT" "$OUTPUT/build.json" <<'PY'
+import json, pathlib, re, subprocess, sys
+source = pathlib.Path(sys.argv[1])
+version = re.search(r'#define FZ_VERSION "([^"]+)"',
+                    (source / 'include/mupdf/fitz/version.h').read_text()).group(1)
+revision = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
+repository = subprocess.check_output(
+    ['git', '-C', str(source), 'remote', 'get-url', 'origin'], text=True).strip()
+dirty = bool(subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain'], text=True))
+# Toolbox adds codec gitlinks in its patch, so upstream HEAD has no codec pins.
+codecs = {name: subprocess.check_output(
+    ['git', '-C', str(source / 'thirdparty' / name), 'rev-parse', 'HEAD'],
+    text=True).strip() for name in ('libwebp', 'libjxl')}
+pathlib.Path(sys.argv[2]).write_text(json.dumps({'version': version, 'revision': revision,
+    'dirty': dirty, 'codecs': codecs, 'repository': repository}, indent=2) + '\n')
+PY
+echo "Native libraries: $OUTPUT/libs"
diff --git a/app/build.gradle b/app/build.gradle
index ac445c0..53e2657 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -4,6 +4,39 @@ plugins {
 }
 
 def taskName = getGradle().getStartParameter().getTaskRequests().toString()
+// Explicit legacy builds still use the libraries prepared by their link script.
+def buildFromMuPdfFork = !project.hasProperty("mupdf") || project.property("mupdf") == "fork"
+
+def buildMuPdfFork = tasks.register("buildMuPdfFork", Exec) {
+    description = "Build Librera JNI libraries from the configured vm75/mupdf checkout"
+    group = "build"
+    workingDir rootProject.projectDir
+    commandLine "bash", rootProject.file("Builder/link_to_mupdf_fork.sh").absolutePath
+    if (taskName.contains("Fdroid")) {
+        args "fdroid"
+    }
+    // ndk-build and CMake track changes in the sibling checkout themselves.
+    // Do not consider an old .so current just because it is already packaged.
+    outputs.dir(layout.projectDirectory.dir("src/main/jniLibs"))
+    outputs.upToDateWhen { false }
+}
+
+tasks.configureEach { task ->
+    // F-Droid variants have no Firebase dependencies or google-services.json.
+    if (task.name.startsWith("processFdroid") && task.name.endsWith("GoogleServices")) {
+        task.enabled = false
+    }
+    if (buildFromMuPdfFork && task.name.startsWith("merge")
+            && (task.name.endsWith("NativeLibs") || task.name.endsWith("JniLibFolders"))) {
+        if (task.name.contains("JS")) {
+            // JS packaging shares liblame with native variants. Order combined builds
+            // without requiring MuPDF when only a JS variant was requested.
+            task.mustRunAfter(buildMuPdfFork)
+        } else {
+            task.dependsOn(buildMuPdfFork)
+        }
+    }
+}
 
 
