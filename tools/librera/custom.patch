+LOCAL_PATH := $(call my-dir)
+TOP_LOCAL_PATH := $(LOCAL_PATH)
+LIBRERA_JNI_PATH := $(LOCAL_PATH)
+LIBRERA_MUPDF_ROOT ?= $(abspath $(LIBRERA_JNI_PATH)/../../../mupdf)
+
+# Reuse the fork's codec/dependency modules instead of copying its source files.
+MUPDF_JNI_STATIC := yes
+include $(LIBRERA_MUPDF_ROOT)/platform/java/Android.mk
+
+MUPDF_ROOT := $(LIBRERA_MUPDF_ROOT)
+include $(TOP_LOCAL_PATH)/libmobi-0.12/Android.mk
+include $(TOP_LOCAL_PATH)/libhqx-1.2/Android.mk
+include $(TOP_LOCAL_PATH)/libdjvu-3.5.28/Android.mk
+include $(TOP_LOCAL_PATH)/libwebp-1.3.2/Android.mk
+include $(TOP_LOCAL_PATH)/liblame-1.0.9/Android.mk
+include $(TOP_LOCAL_PATH)/libarchive-3.8.10/Android.mk
+include $(TOP_LOCAL_PATH)/libjpeg-turbo-3.2.1/Android.mk
+include $(TOP_LOCAL_PATH)/libtiff-4.7.2/Android.mk
+
+# libdjvu.so, libmobi.so, libhqx.so and libpdfannot.so - see that file
+include $(TOP_LOCAL_PATH)/Librera-libs.mk
+
+# --- libmupdf.so: MuPDF and its JNI, for the flavours built with it ---
+include $(CLEAR_VARS)
+LOCAL_PATH := $(TOP_LOCAL_PATH)
+
+LOCAL_ARM_MODE := $(APP_ARM_MODE)
+LOCAL_ARM_NEON := true
+
+LOCAL_C_INCLUDES := \
+    $(LIBRERA_MUPDF_ROOT)/include \
+    $(LIBRERA_MUPDF_ROOT)/source/fitz \
+    $(LIBRERA_MUPDF_ROOT)/source/pdf \
+    $(TOP_LOCAL_PATH)/libwebp-1.3.2/src \
+    $(TOP_LOCAL_PATH)
+
+LOCAL_CFLAGS := -DHAVE_ANDROID
+LOCAL_MODULE := mupdf
+
+LOCAL_SRC_FILES := \
+    ebookdroidjni.c \
+    jni_concurrent.c \
+    androidfonts.c \
+    libmupdf_librera_fork.c \
+    mupdf-image.c
+
+LOCAL_STATIC_LIBRARIES := mupdf_java
+
+LOCAL_LDLIBS := -ljnigraphics -llog -lz -lm
+LOCAL_LDLIBS += $(MUPDF_EXTRA_LDLIBS)
+LOCAL_LDFLAGS += $(MUPDF_EXTRA_LDFLAGS)
+
+include $(BUILD_SHARED_LIBRARY)
