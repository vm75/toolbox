+#include <stdlib.h>
+#include <string.h>
+
+static int checks;
+#define CHECK(ctx, condition) do { \
+	++checks; \
+	if (!(condition)) \
+		fz_throw(ctx, FZ_ERROR_GENERIC, "WebP regression failed at line %d: %s", __LINE__, #condition); \
+} while (0)
+
