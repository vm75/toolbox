+static const unsigned char rgb[] = {255,0,0,0,255,0,0,0,255,255,255,255};
+static const unsigned char rgba[] = {255,0,0,255,0,128,0,128,0,0,0,0,63,30,20,64};
+static const unsigned char gray[] = {0,255,128,64};
+static const unsigned char gray_alpha[] = {0,255,32,128,0,0,64,64};
+static const unsigned char oriented[] = {255,0,0,0,255,0,0,0,255,255,255,255,0,0,0,255,255,0};
+static const unsigned char lossy[] = {40,120,200,40,120,200,40,120,200,40,120,200};
+
+static void
+check_sample(fz_context *ctx, const unsigned char *data, size_t size, const unsigned char *expected,
+	int width, int height, int n, int alpha, int orientation, int tolerance)
+{
+	fz_buffer *buffer = NULL;
+	fz_image *image = NULL;
+	fz_pixmap *pixmap = NULL;
+	fz_var(buffer);
+	fz_var(image);
+	fz_var(pixmap);
+	fz_try(ctx)
+	{
+		int x, y, k;
+		buffer = fz_new_buffer_from_copied_data(ctx, data, size);
+		image = fz_new_image_from_buffer(ctx, buffer);
+		CHECK(ctx, image->w == width && image->h == height);
+		CHECK(ctx, image->xres == 72 && image->yres == 72);
+		CHECK(ctx, fz_image_orientation(ctx, image) == orientation);
+		pixmap = fz_get_unscaled_pixmap_from_image(ctx, image);
+		CHECK(ctx, pixmap->w == width && pixmap->h == height);
+		CHECK(ctx, pixmap->n == n && pixmap->alpha == alpha);
+		CHECK(ctx, fz_colorspace_n(ctx, pixmap->colorspace) == n - alpha);
+		CHECK(ctx, fz_colorspace_type(ctx, pixmap->colorspace) == (n - alpha == 1 ? FZ_COLORSPACE_GRAY : FZ_COLORSPACE_RGB));
+#if FZ_ENABLE_ICC
+		CHECK(ctx, fz_colorspace_is_icc(ctx, pixmap->colorspace));
+#endif
+		for (y = 0; y < height; ++y)
+			for (x = 0; x < width; ++x)
+				for (k = 0; k < n; ++k)
+					CHECK(ctx, abs(pixmap->samples[y * pixmap->stride + x * n + k] - expected[(y * width + x) * n + k]) <= tolerance);
+	}
+	fz_always(ctx)
+	{
+		fz_drop_pixmap(ctx, pixmap);
+		fz_drop_image(ctx, image);
+		fz_drop_buffer(ctx, buffer);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+}
+
+static void
+check_allocation_failures(fz_context *ctx, struct test_state *state)
+{
+	fz_buffer *buffer = fz_new_buffer_from_copied_data(ctx, jxl_rgba, sizeof(jxl_rgba));
+	fz_try(ctx)
+	{
+		int i;
+		for (i = 1; i <= 40; ++i)
+		{
+			fz_image *image = NULL;
+			fz_pixmap *pixmap = NULL;
+			int caught = 0;
+			fz_var(image);
+			fz_var(pixmap);
+			fz_var(caught);
+			state->fail_after = i;
+			fz_try(ctx)
+			{
+				image = fz_new_image_from_buffer(ctx, buffer);
+				pixmap = fz_get_unscaled_pixmap_from_image(ctx, image);
+			}
+			fz_always(ctx)
+			{
+				state->failing = state->fail_after = 0;
+				fz_drop_pixmap(ctx, pixmap);
+				fz_drop_image(ctx, image);
+			}
+			fz_catch(ctx)
+			{
+				caught = fz_caught(ctx);
+				fz_report_error(ctx);
+			}
+			CHECK(ctx, caught == FZ_ERROR_SYSTEM);
+		}
+	}
+	fz_always(ctx)
+		fz_drop_buffer(ctx, buffer);
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+	check_sample(ctx, jxl_rgb, sizeof(jxl_rgb), rgb, 2, 2, 3, 0, 1, 0);
+}
+#endif
+
+static void
+check_error(fz_context *ctx, const unsigned char *data, size_t size, int expected)
+{
+	fz_buffer *buffer = fz_new_buffer_from_copied_data(ctx, data, size);
+	fz_image *image = NULL;
+	fz_pixmap *pixmap = NULL;
+	int caught = 0;
+	fz_var(image);
+	fz_var(pixmap);
+	fz_var(caught);
+	fz_try(ctx)
+	{
+		image = fz_new_image_from_buffer(ctx, buffer);
+		pixmap = fz_get_unscaled_pixmap_from_image(ctx, image);
+	}
+	fz_always(ctx)
+	{
+		fz_drop_pixmap(ctx, pixmap);
+		fz_drop_image(ctx, image);
+		fz_drop_buffer(ctx, buffer);
+	}
+	fz_catch(ctx)
+	{
+		caught = fz_caught(ctx);
+		fz_report_error(ctx);
+	}
+	CHECK(ctx, caught == expected);
+}
+
+int
+main(void)
+{
+	struct test_state state = { 0 };
+	fz_alloc_context alloc = { &state, test_malloc, test_realloc, test_free };
+	fz_context *ctx = fz_new_context(&alloc, NULL, FZ_STORE_DEFAULT);
+	int failed = 0;
+	fz_var(state);
+	fz_var(failed);
+	if (!ctx)
+		return 1;
+	fz_set_error_callback(ctx, test_message, &state);
+	fz_set_warning_callback(ctx, test_message, &state);
+	fz_try(ctx)
+	{
+		CHECK(ctx, fz_lookup_image_type("jxl") == FZ_IMAGE_JXL);
+		CHECK(ctx, !strcmp(fz_image_type_name(FZ_IMAGE_JXL), "jxl"));
+#if FZ_ENABLE_JXL
+		check_sample(ctx, jxl_rgb, sizeof(jxl_rgb), rgb, 2, 2, 3, 0, 1, 0);
+		check_sample(ctx, jxl_rgba, sizeof(jxl_rgba), rgba, 2, 2, 4, 1, 1, 0);
+		check_sample(ctx, jxl_gray16, sizeof(jxl_gray16), gray, 2, 2, 1, 0, 1, 1);
+		check_sample(ctx, jxl_gray_alpha, sizeof(jxl_gray_alpha), gray_alpha, 2, 2, 2, 1, 1, 1);
+		check_sample(ctx, jxl_oriented, sizeof(jxl_oriented), oriented, 3, 2, 3, 0, 4, 0);
+		check_sample(ctx, jxl_lossy, sizeof(jxl_lossy), lossy, 2, 2, 3, 0, 1, 5);
+		check_sample(ctx, jxl_animated, sizeof(jxl_animated), rgb, 2, 2, 3, 0, 1, 0);
+		check_error(ctx, jxl_rgb, 8, FZ_ERROR_FORMAT);
+		check_error(ctx, jxl_rgba, 12, FZ_ERROR_FORMAT);
+		check_allocation_failures(ctx, &state);
+#else
+		check_error(ctx, jxl_rgb, sizeof(jxl_rgb), FZ_ERROR_UNSUPPORTED);
+		check_error(ctx, jxl_rgba, sizeof(jxl_rgba), FZ_ERROR_UNSUPPORTED);
+#endif
+		CHECK(ctx, !state.unhandled);
+	}
+	fz_catch(ctx)
+	{
+		fprintf(stderr, "%s\n", fz_caught_message(ctx));
+		fz_report_error(ctx);
+		failed = 1;
+	}
+	fz_drop_context(ctx);
+	if (!failed)
+		printf("JPEG XL %s tests passed (%d checks)\n", FZ_ENABLE_JXL ? "decoder" : "disabled-build", checks);
+	return failed;
+}

