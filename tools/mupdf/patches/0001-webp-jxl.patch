+	fz_buffer *profile = NULL;
+	fz_buffer *buffer = NULL;
+	fz_image *image = NULL;
+	int caught = 0;
+	fz_var(profile);
+	fz_var(buffer);
+	fz_var(image);
+	fz_var(caught);
+	fz_try(ctx)
+	{
+		unsigned char *data;
+		size_t size;
