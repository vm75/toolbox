diff --git a/scripts/build-android-jxl.py b/scripts/build-android-jxl.py
index 000000000000..39cf9f234c84 100644
--- /dev/null
+++ b/scripts/build-android-jxl.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Build a relocatable static JPEG XL decoder SDK for ndk-build, per Android ABI."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+
+ROOT = Path(__file__).resolve().parent.parent
+ABIS = ("armeabi-v7a", "arm64-v8a", "x86", "x86_64")
+
+
+def run(*args, **kwargs):
+    subprocess.run([str(arg) for arg in args], check=True, **kwargs)
+
+
+def build(args, abi):
+    work = args.output / ".build" / abi
+    sdk = args.output / abi
+    run("cmake", "-S", ROOT / "platform/android/jxl", "-B", work,
+        "-DCMAKE_TOOLCHAIN_FILE=" + str(args.ndk / "build/cmake/android.toolchain.cmake"),
+        "-DANDROID_ABI=" + abi, "-DANDROID_PLATFORM=android-" + str(args.api),
+        "-DANDROID_STL=c++_static", "-DCMAKE_BUILD_TYPE=Release",
+        "-DMUPDF_LIBJXL_SOURCE_DIR=" + str(args.source))
+    header = work / "libjxl/lib/include/jxl/version.h"
+    version = tuple(int(re.search(r"#define JPEGXL_" + part + r"_VERSION\s+(\d+)",
+                                  header.read_text()).group(1))
+                    for part in ("MAJOR", "MINOR", "PATCH"))
+    if version < (0, 12, 0):
+        raise ValueError("libjxl 0.12.0 or newer is required")
+    run("cmake", "--build", work, "--target", "jxl_dec", "jxl_cms",
+        "--parallel", args.jobs)
+    archives = (work / "mupdf-jxl-archives.txt").read_text().splitlines()
+    # Paths are passed to llvm-ar's MRI language, which does not quote whitespace.
+    # Running in a directory of numbered symlinks avoids interpreting source paths.
+    merge = work / "merge"
+    merge.mkdir(exist_ok=True)
+    for i, archive in enumerate(archives):
+        link = merge / f"{i}.a"
+        if link.is_symlink():
+            link.unlink()
+        link.symlink_to(archive)
+    cache = (work / "CMakeCache.txt").read_text()
+    ar = re.search(r"^CMAKE_AR:FILEPATH=(.+)$", cache, re.MULTILINE).group(1)
+    mri = "CREATE libmupdf-jxl.a\n" + "".join(f"ADDLIB {i}.a\n" for i in range(len(archives)))
+    run(ar, "-M", input=mri + "SAVE\nEND\n", text=True, cwd=merge)
+    run(ar, "s", merge / "libmupdf-jxl.a")
+    (sdk / "lib").mkdir(parents=True, exist_ok=True)
+    shutil.copy2(merge / "libmupdf-jxl.a", sdk / "lib/libmupdf-jxl.a")
+    include = sdk / "include/jxl"
+    include.mkdir(parents=True, exist_ok=True)
+    for directory in (args.source / "lib/include/jxl", header.parent):
+        for path in directory.glob("*.h"):
+            shutil.copy2(path, include / path.name)
+    # Keep redistribution notices with the SDK, including the embedded dependencies.
+    licenses = sdk / "licenses"
+    licenses.mkdir(exist_ok=True)
+    for name, path in {
+        "libjxl": args.source / "LICENSE",
+        "highway": args.source / "third_party/highway/LICENSE",
+        "brotli": args.source / "third_party/brotli/LICENSE",
+        "skcms": args.source / "third_party/skcms/LICENSE",
+    }.items():
+        shutil.copy2(path, licenses / (name + ".txt"))
+    manifest = {"abi": abi, "api": args.api, "libjxl": ".".join(map(str, version)),
+                "ndk": (args.ndk / "source.properties").read_text()}
+    (sdk / "build.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print("JPEG XL SDK:", sdk, flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, required=True,
+                        help="libjxl 0.12.0+ checkout with its submodules initialized")
+    parser.add_argument("--ndk", type=Path, required=True)
+    parser.add_argument("--output", type=Path, default=ROOT / "build/android-jxl")
+    parser.add_argument("--abis", nargs="+", choices=ABIS, default=list(ABIS))
+    parser.add_argument("--api", type=int, default=24)
+    parser.add_argument("--jobs", type=int, default=min(os.cpu_count() or 1, 4))
+    args = parser.parse_args()
+    args.source = args.source.resolve()
+    args.ndk = args.ndk.resolve()
+    args.output = args.output.resolve()
+    if args.api < 21 or args.jobs < 1:
+        parser.error("--api must be at least 21 and --jobs must be positive")
+    if not (args.ndk / "build/cmake/android.toolchain.cmake").is_file():
+        parser.error("--ndk must name an Android NDK installation")
+    try:
+        for abi in args.abis:
+            build(args, abi)
+    except (OSError, ValueError, subprocess.CalledProcessError) as error:
+        parser.exit(1, str(error) + "\n")
+
+
+if __name__ == "__main__":
+    main()

diff --git a/scripts/test-android-codecs.py b/scripts/test-android-codecs.py
index 000000000000..5e2b87c17310 100644
--- /dev/null
+++ b/scripts/test-android-codecs.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Exercise Android.mk's codec selection without requiring an Android toolchain."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+class AndroidCodecTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="mupdf-android-config-")
+        self.addCleanup(self.temp.cleanup)
+        self.directory = Path(self.temp.name)
+        (self.directory / "clear.mk").write_text(
+            "LOCAL_MODULE :=\nLOCAL_SRC_FILES :=\nLOCAL_C_INCLUDES :=\n"
+            "LOCAL_CFLAGS :=\nLOCAL_STATIC_LIBRARIES :=\nLOCAL_EXPORT_CFLAGS :=\n"
+            "LOCAL_EXPORT_C_INCLUDES :=\nLOCAL_EXPORT_LDLIBS :=\nLOCAL_EXPORT_LDFLAGS :=\n")
+        (self.directory / "module.mk").write_text(
+            "$(info MODULE $(LOCAL_MODULE) $(LOCAL_STATIC_LIBRARIES))\n")
+        (self.directory / "shared.mk").write_text(
+            "$(info SHARED $(LOCAL_MODULE))\n$(info MODULE $(LOCAL_MODULE) $(LOCAL_STATIC_LIBRARIES))\n")
+        (self.directory / "Makefile").write_text(
+            "my-dir = " + str(ROOT / "platform/java") + "\n"
+            "TARGET_CC := cc\nTARGET_ARCH_ABI := arm64-v8a\n"
+            "CLEAR_VARS := " + str(self.directory / "clear.mk") + "\n"
+            "BUILD_STATIC_LIBRARY := " + str(self.directory / "module.mk") + "\n"
+            "BUILD_SHARED_LIBRARY := " + str(self.directory / "shared.mk") + "\n"
+            "PREBUILT_STATIC_LIBRARY := $(BUILD_STATIC_LIBRARY)\n"
+            "include " + str(ROOT / "platform/java/Android.mk") + "\n"
+            "all: ; @:\n")
+        self.environment = os.environ.copy()
+        for key in ("MAKEFLAGS", "MFLAGS", "MAKEOVERRIDES", "APP_CFLAGS",
+                    "MUPDF_EXTRA_CFLAGS", "FZ_ENABLE_WEBP", "FZ_ENABLE_JXL"):
+            self.environment.pop(key, None)
+
+    def config(self, *args, sdk=True, ok=True):
+        if sdk:
+            for suffix in ("include/jxl/decode.h", "lib/libmupdf-jxl.a"):
+                path = self.directory / "arm64-v8a" / suffix
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.touch()
+        result = subprocess.run(["make", "--no-print-directory", "-s",
+                                 "MUPDF_JXL_ROOT=" + str(self.directory), *args],
+                                cwd=self.directory, env=self.environment,
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode == 0, ok, result.stdout + result.stderr)
+        return result.stdout + result.stderr
+
+    def test_independent_switches(self):
+        for webp, jxl in ((1, 1), (0, 1), (1, 0), (0, 0)):
+            with self.subTest(webp=webp, jxl=jxl):
+                output = self.config("FZ_ENABLE_WEBP=" + str(webp), "FZ_ENABLE_JXL=" + str(jxl))
+                self.assertEqual("MODULE mupdf_thirdparty_libwebp" in output, bool(webp))
+                self.assertEqual("MODULE mupdf_thirdparty_libjxl" in output, bool(jxl))
+
+    def test_default_both_enabled(self):
+        output = self.config()
+        self.assertIn("MODULE mupdf_thirdparty_libwebp", output)
+        self.assertIn("MODULE mupdf_thirdparty_libjxl", output)
+
+    def test_disabled_jxl_needs_no_sdk(self):
+        self.config("FZ_ENABLE_JXL=0", sdk=False)
+
+    def test_missing_jxl_sdk_fails_actionably(self):
+        self.assertIn("JPEG XL requires an Android SDK", self.config(sdk=False, ok=False))
+
+    def test_compiler_defines_are_honored(self):
+        output = self.config("MUPDF_EXTRA_CFLAGS=-DFZ_ENABLE_WEBP=0 -DFZ_ENABLE_JXL=0", sdk=False)
+        self.assertNotIn("MODULE mupdf_thirdparty_libwebp", output)
+        self.assertNotIn("MODULE mupdf_thirdparty_libjxl", output)
+
+    def test_static_jni_reuses_the_dependency_modules(self):
+        self.assertIn("SHARED mupdf_java", self.config())
+        output = self.config("MUPDF_JNI_STATIC=yes")
+        self.assertNotIn("SHARED mupdf_java", output)
+        self.assertIn("MODULE mupdf_java", output)
+        self.assertIn("mupdf_thirdparty_libjxl", output)
+
+    def test_bad_compiler_fails_explicitly(self):
+        self.assertIn("Cannot read Android codec configuration", self.config("TARGET_CC=false", ok=False))
+
+
+if __name__ == "__main__":
+    unittest.main()

